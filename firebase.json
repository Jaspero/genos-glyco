{
  "hosting": [{
    "target": "website",
    "public": "static",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://genos.hr",
        "type": 301
      },
      {
        "source": "/publications",
        "destination": "https://genos.hr/publications",
        "type": 301
      },
      {
        "source": "/services",
        "destination": "https://genos.hr/services",
        "type": 301
      },
      {
        "source": "/projects",
        "destination": "https://genos.hr/projects",
        "type": 301
      },
      {
        "source": "/projects/**",
        "destination": "https://genos.hr/projects",
        "type": 301
      },
      {
        "source": "/news",
        "destination": "https://genos.hr/news",
        "type": 301
      },
      {
        "source": "/news/**",
        "destination": "https://genos.hr/news",
        "type": 301
      },
      {
        "source": "/our-team",
        "destination": "https://genos.hr/team",
        "type": 301
      },
      {
        "source": "/contact-us",
        "destination": "https://genos.hr/contact",
        "type": 301
      },
      {
        "source": "**",
        "destination": "https://genos.hr",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "ssr"
      }
    ]
  }]
}
